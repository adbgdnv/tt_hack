# секреты — никогда в репозиторий
.env
.env.local
*.key

# vibe-debug: локальное хранилище комментариев/вложений
.vibe-debug/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# macOS
.DS_Store

# черновики
temp/

# выгрузка кейсодателя — симлинк наружу
data

# подготовленный набор: собирается скриптом, содержит данные учредителей
dataset/

# eval: сгенерированный датасет и результаты живых прогонов содержат реальные ИНН
evals/datasets/*
!evals/datasets/.gitkeep
evals/results/*
!evals/results/.gitkeep
