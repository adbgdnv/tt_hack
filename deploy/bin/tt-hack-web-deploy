#!/bin/bash
# Выкатка фронтенда. Копия для истории; рабочий экземпляр лежит на сервере
# в /usr/local/bin/ и принадлежит root.
#
# Почему root-owned и вне git-клона — та же причина, что у tt-hack-api-deploy:
# скрипт запускается через sudo, и правом на его правку деплой-пользователь
# получил бы полный root, а не узкое право выкатить фронт.
#
# Разрешение выдано строкой в /etc/sudoers.d/tt-hack-api:
#   ttdeploy ALL=(root) NOPASSWD: /usr/local/bin/tt-hack-web-deploy
#
# Образ НЕ собирается здесь. Раньше собирался, и именно это клало сервис:
# установка зависимостей и упаковка на машине с 894 МБ памяти доводили нагрузку
# до 27, SSH переставал отвечать, а отмена выкатки на середине оставила
# контейнер «созданным, но не запущенным» — сайт лежал, пока его не подняли
# руками. Теперь собирает раннер, сюда приезжает готовое.
#
# Порядок в workflow: окружение → бэкенд → ЭТОТ скрипт. Новый бэкенд шлёт поля,
# которых старый фронт не знает, — тот их игнорирует. Обратный порядок ронял
# страницу в белый экран.
set -euo pipefail

REPO=/opt/tt-hack
LOG_PREFIX="[web-deploy]"
TAG="${1:-latest}"
export TAG

echo "${LOG_PREFIX} метка: ${TAG}"

# Входа в реестр здесь нет намеренно. Образы публичные — реестр наследует
# видимость репозитория, а он открыт, — и скачиваются без учётных данных.
# Закрывать в них нечего: код и так открыт, набор данных подключается томом,
# ключи задаются при запуске. Взамен на машине нет ни одной записи к реестру:
# на один доступ и на одну возможность отказа меньше.
#
# Если образы когда-нибудь закроют, вход придётся делать ЗДЕСЬ, а не в вызывающем:
# sudo у пользователя выкатки выдан ровно на два этих файла, и отдельный
# `sudo docker login` отвергается. Проверено — так и произошло на первом прогоне,
# причём sudo не дал даже пробросить переменную окружения.


git -C "${REPO}" fetch --quiet origin main
git -C "${REPO}" reset --hard --quiet origin/main
chown -R www-data:www-data "${REPO}"
chown ttdeploy:ttdeploy "${REPO}/.env" 2>/dev/null || true

cd "${REPO}"

# Точка отката — образ, на котором фронт работает сейчас. Берём до подмены.
PREVIOUS=$(docker inspect cc-web --format '{{.Config.Image}}' 2>/dev/null || echo "")

echo "${LOG_PREFIX} забираю образ"
if ! docker compose pull web; then
  echo "${LOG_PREFIX} ОШИБКА: образ не скачался — оставляю работающий" >&2
  exit 1
fi

rollback() {
  if [ -z "${PREVIOUS}" ]; then
    echo "${LOG_PREFIX} откатываться не на что — это первая выкатка" >&2
    return
  fi
  echo "${LOG_PREFIX} откат на ${PREVIOUS}" >&2
  TAG="${PREVIOUS##*:}" docker compose up -d --no-build --force-recreate web >&2
  echo "${LOG_PREFIX} откат выполнен" >&2
}

echo "${LOG_PREFIX} подменяю контейнер"
# --no-build: поднимаем ровно то, что скачали. Без него compose при заминке
# с образом соберёт его сам — то есть вернёт исходную беду.
if ! docker compose up -d --no-build web; then
  echo "${LOG_PREFIX} ОШИБКА: контейнер не запустился" >&2
  rollback
  exit 1
fi

# Старые образы этого сервиса. Каждая выкатка приносит новый — за неделю
# ежедневных выкаток это несколько гигабайт на диске, которого 14 ГБ.
# Оставляем два: работающий и предыдущий, на который откатываемся. Остальные
# при нужде забираются из реестра, там хранится десять.
#
# Идёт ПОСЛЕ проверки здоровья: пока не убедились, что новый образ работает,
# удалять старые нельзя.
prune_old_images() {
  local repo="$1"
  docker images "${repo}" --format '{{.ID}} {{.CreatedAt}}' \
    | sort -k2 -r | tail -n +3 | awk '{print $1}' \
    | xargs -r docker rmi >/dev/null 2>&1 || true
}

# Проверяем и статику, и проксирование в бэкенд: контейнер, отдающий index.html
# без живого /api, показывает пустую страницу — снаружи это выглядит как рабочий
# фронт.
for attempt in $(seq 1 20); do
  if curl -fsS --max-time 3 localhost:5173/ >/dev/null 2>&1 \
     && curl -fsS --max-time 3 localhost:5173/api/health >/dev/null 2>&1; then
    echo "${LOG_PREFIX} здоров: статика и /api отвечают"
    prune_old_images "ghcr.io/adbgdnv/tt_hack/web"
    exit 0
  fi
  sleep 2
done

echo "${LOG_PREFIX} ОШИБКА: фронт не ответил за 40 секунд" >&2
docker logs cc-web --tail 30 >&2
rollback
exit 1
