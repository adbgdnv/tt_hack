#!/bin/bash
# Выкатка фронтенда контейнером. Копия для истории; рабочий экземпляр лежит
# на сервере в /usr/local/bin/ и принадлежит root.
#
# Почему root-owned и вне git-клона — та же причина, что у tt-hack-api-deploy:
# скрипт запускается через sudo, и правом на его правку деплой-пользователь получил
# бы полный root, а не узкое право выкатить фронт.
#
# Разрешение выдано строкой в /etc/sudoers.d/tt-hack-api:
#   ttdeploy ALL=(root) NOPASSWD: /usr/local/bin/tt-hack-web-deploy
#
# Порядок в workflow: окружение → бэкенд → ЭТОТ скрипт. Новый бэкенд шлёт поля,
# которых старый фронт не знает, — тот их игнорирует. Обратный порядок ронял
# страницу в белый экран.
set -euo pipefail

REPO=/opt/tt-hack
LOG_PREFIX="[web-deploy]"

echo "${LOG_PREFIX} было: $(git -C "${REPO}" rev-parse --short HEAD)"
git -C "${REPO}" fetch --quiet origin main
git -C "${REPO}" reset --hard --quiet origin/main
chown -R www-data:www-data "${REPO}"
# .env пишет деплой отдельным шагом — владельца возвращаем ему
chown ttdeploy:ttdeploy "${REPO}/.env" 2>/dev/null || true
echo "${LOG_PREFIX} стало: $(git -C "${REPO}" rev-parse --short HEAD)"

cd "${REPO}"

# Точка отката: текущий рабочий образ. Если его ещё нет (первая выкатка),
# откатываться будет некуда — это отдельно проверяется ниже.
HAVE_PREVIOUS=0
if docker image inspect cc-web:latest >/dev/null 2>&1; then
  docker image tag cc-web:latest cc-web:previous
  HAVE_PREVIOUS=1
fi

# Возврат на предыдущий образ. Вызывается из любой точки после успешной сборки:
# с этого момента тег latest указывает на непроверенный образ, и оставлять его
# так нельзя — следующая выкатка сохранила бы сломанное как точку отката.
rollback() {
  if [ "${HAVE_PREVIOUS}" -eq 0 ]; then
    echo "${LOG_PREFIX} откатываться не на что — это первая выкатка" >&2
    return
  fi
  echo "${LOG_PREFIX} откат на предыдущий образ" >&2
  docker image tag cc-web:previous cc-web:latest
  # --no-build: поднимаем ровно тот образ, что сейчас под тегом latest,
  # иначе compose пересобрал бы ту же сломанную версию.
  docker compose up -d --force-recreate --no-build web >&2
  echo "${LOG_PREFIX} откат выполнен" >&2
}

# Сборка отдельным шагом от запуска: пока она идёт, наружу продолжает отвечать
# старый контейнер. Упавшая сборка (ошибка tsc, недоступный npm) не должна
# ронять работающий фронт — поэтому и выходим здесь, до подмены контейнера.
# Тег latest при этом остаётся на старом образе: откатывать нечего.
echo "${LOG_PREFIX} сборка образа"
docker compose build web

echo "${LOG_PREFIX} запуск контейнера"
if ! docker compose up -d web; then
  echo "${LOG_PREFIX} ОШИБКА: контейнер не запустился" >&2
  rollback
  exit 1
fi

# Пока контейнер не ответит, деплой не считается успешным. Проверяем и статику,
# и проксирование в бэкенд: контейнер, отдающий index.html без живого /api,
# показывает пустую страницу — снаружи это выглядит как рабочий фронт.
for attempt in $(seq 1 20); do
  if curl -fsS --max-time 3 localhost:5173/ >/dev/null 2>&1 \
     && curl -fsS --max-time 3 localhost:5173/api/health >/dev/null 2>&1; then
    echo "${LOG_PREFIX} здоров: статика и /api отвечают"
    exit 0
  fi
  sleep 2
done

echo "${LOG_PREFIX} ОШИБКА: фронт не ответил за 40 секунд" >&2
docker logs cc-web --tail 30 >&2
rollback
exit 1
