# Провайдер LLM. Сейчас работаем на Groq.
# Ключ: console.groq.com -> API Keys -> Create API Key (бесплатно, без карты)
LLM_PROVIDER=groq
LLM_API_KEY=gsk_ВСТАВЬ_СЮДА_КЛЮЧ

# Необязательно — переопределяют дефолты провайдера
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# Запасной вариант, если Groq упрётся в лимит или ляжет.
# gpt-oss-20b там платный, но ~13 центов за тысячу запросов.
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-...

# Подготовленный набор контрагентов. Файл не приходит с кодом — он собирается
# скриптом `python3 scripts/build_dataset.py` из выгрузки кейсодателя.
# В репозиторий не коммитится: репозиторий публичный, а в данных сведения
# об учредителях. На сервере переменная указывает туда, куда набор скопирован.
# DATASET_PATH=dataset/counterparties.json

# Префикс, под которым сервис живёт за обратным прокси. Локально пусто — сервис
# в корне. На превью-сервере nginx отдаёт его по /api/, и без этой переменной
# Swagger на /api/docs просит схему с корня и ломается. На сопоставление
# маршрутов не влияет.
# API_ROOT_PATH=/api
