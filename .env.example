# Провайдер LLM. Сейчас работаем на Groq.
# Ключ: console.groq.com -> API Keys -> Create API Key (бесплатно, без карты)
LLM_PROVIDER=groq
LLM_API_KEY=gsk_ВСТАВЬ_СЮДА_КЛЮЧ

# Необязательно — переопределяют дефолты провайдера
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# Запасной вариант, если Groq упрётся в лимит или ляжет.
# gpt-oss-20b там платный, но ~13 центов за тысячу запросов.
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-...

# Подготовленный набор контрагентов. Файл не приходит с кодом — он собирается
# скриптом `python3 scripts/build_dataset.py` из выгрузки кейсодателя.
# В репозиторий не коммитится: репозиторий публичный, а в данных сведения
# об учредителях. На сервере переменная указывает туда, куда набор скопирован.
# DATASET_PATH=dataset/counterparties.json

# Префикс, под которым сервис живёт за обратным прокси. Локально пусто — сервис
# в корне. На превью-сервере nginx отдаёт его по /api/, и без этой переменной
# Swagger на /api/docs просит схему с корня и ломается. На сопоставление
# маршрутов не влияет.
# API_ROOT_PATH=/api

# Трассировка вызовов модели в LangSmith. Записи создаёт сам клиент LangChain,
# своего кода для этого нет. Без LANGSMITH_TRACING=true она молча выключена —
# тесты и CI никуда не обращаются, условий в коде для этого не нужно.
# Промпт уходит как есть, включая ФИО руководителей и ИНН из отчёта: решение
# принято осознанно, разбор поведения модели признан важнее.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=counterparty-checker

# Поиск во внешних открытых источниках. Ходим к поставщику по MCP — продукт
# выступает не только MCP-сервером, но и MCP-клиентом.
# Ключ: tavily.com -> API Keys. Без него инструмент поиска модели не предлагается
# вовсе, и остальной продукт работает без изменений: описание неработающего
# инструмента стоило бы токенов на каждом вызове.
# TAVILY_API_KEY=tvly-...
